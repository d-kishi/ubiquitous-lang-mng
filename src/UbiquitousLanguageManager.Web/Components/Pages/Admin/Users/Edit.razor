@page "/admin/users/edit/{IdentityId}"
@using Microsoft.AspNetCore.Authorization
@using UbiquitousLanguageManager.Contracts.DTOs
@using UbiquitousLanguageManager.Contracts.Enums
@using UbiquitousLanguageManager.Contracts.Converters
@using UbiquitousLanguageManager.Application
@using UbiquitousLanguageManager.Application.ProjectManagement
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "SuperUser,ProjectManager")]
@inject IUserManagementService UserManagementService
@inject IProjectManagementService ProjectService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>ユーザー編集</PageTitle>

@* 【Blazor初学者向け解説】
   このコンポーネントは、既存ユーザー情報を編集する画面です（UI設計書3.8章準拠）。
   Phase B-F3 Step1.5 Stage4で全面リファクタを実施しました。

   主要機能:
   1. AssignedProjectIds復元: GetProjectIdsByUserIdAsyncでチェックボックス初期状態を復元
   2. パスワードリセット: ResetPasswordAsyncでSuperUserが強制変更可能
   3. プロジェクト表示条件: SuperUserは非表示、それ以外は表示
   4. ロール選択制限: ProjectManagerはGeneralUser/DomainApproverのみ選択可能
   5. FullHDレイアウト: container-fluid + col-12ベース、入力フィールド2カラム配置
*@

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1><i class="fas fa-user-edit"></i> ユーザー編集</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/users">ユーザー管理</a></li>
                    <li class="breadcrumb-item active" aria-current="page">編集</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (loading)
    {
        <div class="row">
            <div class="col-12">
                <div class="text-center my-5">
                    <div class="spinner-border text-primary" role="status" data-testid="loading-spinner">
                        <span class="visually-hidden">読み込み中...</span>
                    </div>
                    <p class="mt-2">ユーザー情報を読み込んでいます...</p>
                </div>
            </div>
        </div>
    }
    else if (errorMessage != null)
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-danger" role="alert" data-testid="error-message">
                    <i class="fas fa-exclamation-triangle"></i> @errorMessage
                    <br />
                    <button class="btn btn-secondary mt-2" @onclick="GoBack" data-testid="error-back-button">
                        <i class="fas fa-arrow-left"></i> 戻る
                    </button>
                </div>
            </div>
        </div>
    }
    else
    {
        @* UI設計書3.8章準拠: FullHDレイアウト（センタリング・1カラム配置） *@
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="fas fa-user-edit"></i> ユーザー情報編集</h5>
                    </div>
                    <div class="card-body">
                        <EditForm Model="@model" OnValidSubmit="UpdateUser" OnInvalidSubmit="OnInvalidSubmit">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="alert alert-danger" />

                            @* UI設計書3.8章準拠: 1カラムレイアウト *@
                            @* メールアドレス（表示のみ・変更不可） *@
                            @* 【Blazor初学者向け解説】
                               UI設計書3.8章: メールアドレスは表示のみ（変更不可）
                               disabledとreadonlyの両方を指定することで、完全に変更不可とします。
                            *@
                            <div class="mb-3">
                                <label for="email" class="form-label fw-bold fs-6">
                                    📧 メールアドレス（変更不可）
                                </label>
                                <input type="text"
                                       class="form-control bg-light"
                                       id="email"
                                       value="@model.Email"
                                       readonly
                                       disabled
                                       data-testid="email-display" />
                                <div class="form-text">
                                    <i class="fas fa-lock text-warning"></i> メールアドレスは変更できません
                                </div>
                            </div>

                            @* ユーザー名（必須） *@
                            <div class="mb-3">
                                <label for="name" class="form-label fw-bold fs-6">
                                    👤 氏名 <span class="text-danger">*</span>
                                </label>
                                <InputText id="name"
                                          class="form-control"
                                          @bind-Value="model.Name"
                                          placeholder="田中太郎"
                                          data-testid="name-input" />
                                <ValidationMessage For="() => model.Name" class="text-danger" />
                                <div class="form-text">画面表示に使用される名前（50文字以内）</div>
                            </div>

                            @* ───────────────────────────────────────────────
                               セクション区切り: 基本情報 → 権限設定
                            ─────────────────────────────────────────────── *@
                            <hr class="my-4" />

                            @* ロール選択（必須） *@
                            @* 【Blazor Server初学者向け解説】
                               UI設計書3.8章: ロール選択制限
                               - SuperUser: 全4ロール選択可能
                               - ProjectManager: GeneralUser, DomainApproverのみ選択可能

                               InputRadio<TValue>のValue属性はTValue型（この場合string）
                               Value="SuperUser"と書くと変数SuperUserを探す
                               Value="@("SuperUser")"と書くと文字列リテラル"SuperUser"として解釈される

                               InputRadioGroup の Name 属性について:
                               - InputRadio に name 属性を指定する場合、親の InputRadioGroup にも同じ Name 属性が必要です
                               - これにより、HTML の <input type="radio" name="role"> が正しくグループ化されます
                               - Name 属性がないと、Blazor Server は InvalidOperationException をスローします
                            *@
                            <div class="mb-3">
                                <label class="form-label fw-bold fs-6">
                                    🎭 ユーザーロール <span class="text-danger">*</span>
                                </label>
                                <InputRadioGroup @bind-Value="model.Role" Name="role">
                                    @* SuperUser選択肢: SuperUserのみ表示 *@
                                    @if (operatorRole == "SuperUser")
                                    {
                                        <div class="form-check">
                                            <InputRadio id="role-superuser"
                                                       class="form-check-input"
                                                       name="role"
                                                       Value="@("SuperUser")"
                                                       data-testid="role-dropdown-superuser" />
                                            <label class="form-check-label" for="role-superuser">
                                                <span class="badge bg-danger">スーパーユーザー</span>
                                                - 全機能・全プロジェクトへのアクセス権限
                                            </label>
                                        </div>
                                        <div class="form-check">
                                            <InputRadio id="role-projectmanager"
                                                       class="form-check-input"
                                                       name="role"
                                                       Value="@("ProjectManager")"
                                                       data-testid="role-dropdown-projectmanager" />
                                            <label class="form-check-label" for="role-projectmanager">
                                                <span class="badge bg-warning text-dark">プロジェクトマネージャー</span>
                                                - 割り当てプロジェクトの管理権限
                                            </label>
                                        </div>
                                    }

                                    @* ProjectManager/SuperUser共通選択肢 *@
                                    <div class="form-check">
                                        <InputRadio id="role-domainapprover"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("DomainApprover")"
                                                   data-testid="role-dropdown-domainapprover" />
                                        <label class="form-check-label" for="role-domainapprover">
                                            <span class="badge bg-info text-dark">ドメイン承認者</span>
                                            - ユビキタス言語の承認権限
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio id="role-generaluser"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("GeneralUser")"
                                                   data-testid="role-dropdown-generaluser" />
                                        <label class="form-check-label" for="role-generaluser">
                                            <span class="badge bg-secondary">一般ユーザー</span>
                                            - 基本的な参照・編集権限
                                        </label>
                                    </div>
                                </InputRadioGroup>
                                <ValidationMessage For="() => model.Role" class="text-danger" />

                                @* ProjectManager権限制限の説明 *@
                                @if (operatorRole == "ProjectManager")
                                {
                                    <div class="form-text text-info">
                                        <i class="fas fa-info-circle"></i> プロジェクトマネージャーは、一般ユーザーとドメイン承認者のみ選択できます
                                    </div>
                                }
                            </div>

                            @* プロジェクト割り当て *@
                            @* 【Blazor初学者向け解説】
                               UI設計書3.8章: プロジェクト表示条件
                               - SuperUser: 非表示（SuperUserはプロジェクト所属不要・全プロジェクト参照可能）
                               - GeneralUser/DomainApprover/ProjectManager: 表示（プロジェクト所属必須）

                               AssignedProjectIds復元（Phase B-F3 Stage4実装完了）:
                               - LoadUserAsync内でGetProjectIdsByUserIdAsyncを呼び出し
                               - 既存のプロジェクト割り当て情報を取得してmodel.AssignedProjectIdsに格納
                               - チェックボックスのchecked属性で初期状態を復元
                            *@
                            @if (model.Role != "SuperUser")
                            {
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold fs-6">
                                            📁 所属プロジェクト（任意）
                                        </label>
                                        <div class="border rounded p-3 d-flex flex-wrap gap-3" style="max-height: 300px; overflow-y: auto;">
                                            @if (availableProjects.Any())
                                            {
                                                @foreach (var project in availableProjects)
                                                {
                                                    <div class="form-check">
                                                        <input type="checkbox"
                                                               class="form-check-input"
                                                               id="project-@project.Id"
                                                               value="@project.Id"
                                                               checked="@model.AssignedProjectIds.Contains(project.Id)"
                                                               @onchange="e => ToggleProject(project.Id, e)"
                                                               data-testid="project-checkbox-@project.Id" />
                                                        <label class="form-check-label" for="project-@project.Id">
                                                            @project.Name
                                                        </label>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">プロジェクトがありません</p>
                                            }
                                        </div>
                                        <div class="form-text">
                                            <i class="fas fa-info-circle"></i> SuperUserはプロジェクト所属不要（全プロジェクトアクセス可能）
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ───────────────────────────────────────────────
                               セクション区切り: 権限設定 → 状態管理
                            ─────────────────────────────────────────────── *@
                            <hr class="my-4" />

                            @* ステータス（有効/無効） *@
                            @* 【Blazor初学者向け解説】
                               UI設計書3.8章: ステータス変更（有効/無効切り替え）
                               トグルスイッチ（form-switch）で視覚的に分かりやすく表示
                               ON=有効（ログイン可能）、OFF=無効（ログイン不可）の直感的UIパターン
                            *@
                            <div class="mb-3">
                                <label class="form-label fw-bold fs-6">📊 アカウント有効</label>
                                <div class="form-check form-switch">
                                    <InputCheckbox id="isActive"
                                                  class="form-check-input"
                                                  @bind-Value="model.IsActive"
                                                  data-testid="status-toggle" />
                                    <label class="form-check-label" for="isActive">
                                        @if (model.IsActive)
                                        {
                                            <span class="badge bg-success">有効</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">無効</span>
                                        }
                                    </label>
                                </div>
                                <div class="form-text">
                                    <i class="fas fa-exclamation-triangle text-warning"></i> 無効に設定すると、ログインできなくなります
                                </div>
                            </div>

                            @* ───────────────────────────────────────────────
                               セクション区切り: 状態管理 → 管理操作
                            ─────────────────────────────────────────────── *@
                            @* パスワードリセット（SuperUserのみ表示） *@
                            @* 【Blazor初学者向け解説】
                               UI設計書3.8章: パスワードリセット機能
                               SuperUserが他ユーザーのパスワードを強制的に変更できます。
                               ボタンクリックでモーダルを表示し、新パスワードを入力します。
                               ResetPasswordAsyncメソッドを使用して実装完了（Phase B-F3 Stage4）
                            *@
                            @if (operatorRole == "SuperUser")
                            {
                                <hr class="my-4" />
                                <div class="row">
                                    <div class="col-12 mb-3">
                                        <label class="form-label fw-bold fs-6">🔄 パスワードリセット</label>
                                        <div class="card border-warning">
                                            <div class="card-body">
                                                <p class="card-text">
                                                    <i class="fas fa-key text-warning"></i> 管理者として、このユーザーのパスワードを強制的に変更できます
                                                </p>
                                                <button type="button"
                                                        class="btn btn-warning"
                                                        @onclick="ShowPasswordResetModal"
                                                        data-testid="password-reset-button">
                                                    <i class="fas fa-unlock-alt"></i> 新しいパスワードを設定
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* 送信・戻るボタン（右寄せ） *@
                            <div class="row">
                                <div class="col-12">
                                    <div class="text-end mt-4">
                                        <button type="button"
                                                class="btn btn-secondary me-2"
                                                @onclick="GoBack"
                                                disabled="@isSubmitting"
                                                data-testid="back-button">
                                            <i class="fas fa-arrow-left"></i> 戻る
                                        </button>
                                        <button type="submit"
                                                class="btn btn-primary"
                                                disabled="@isSubmitting"
                                                data-testid="submit-button">
                                            @if (isSubmitting)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                                <span>更新中...</span>
                                            }
                                            else
                                            {
                                                <i class="fas fa-save"></i>
                                                <span>更新</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@* パスワードリセットモーダル（Bootstrap 5 Modal） *@
@* 【Blazor初学者向け解説】
   Bootstrap 5のモーダルコンポーネントを使用してパスワードリセットUIを実装します。
   show/hideはJavaScript（IJSRuntime）で制御します。
*@
<div class="modal fade" id="passwordResetModal" tabindex="-1" aria-labelledby="passwordResetModalLabel" aria-hidden="true" data-testid="password-reset-modal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="passwordResetModalLabel">
                    <i class="fas fa-key"></i> パスワードリセット
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@passwordResetModel" OnValidSubmit="ExecutePasswordReset">
                    <DataAnnotationsValidator />

                    <div class="alert alert-warning" role="alert">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>@model.Name</strong> のパスワードを強制的に変更します
                    </div>

                    <div class="mb-3">
                        <label for="newPassword" class="form-label fw-bold">
                            🔐 新しいパスワード <span class="text-danger">*</span>
                        </label>
                        <InputText id="newPassword"
                                  type="password"
                                  class="form-control"
                                  @bind-Value="passwordResetModel.NewPassword"
                                  placeholder="8文字以上"
                                  data-testid="new-password-input" />
                        <ValidationMessage For="() => passwordResetModel.NewPassword" class="text-danger" />
                    </div>

                    <div class="mb-3">
                        <label for="confirmPassword" class="form-label fw-bold">
                            ✅ パスワード（確認） <span class="text-danger">*</span>
                        </label>
                        <InputText id="confirmPassword"
                                  type="password"
                                  class="form-control"
                                  @bind-Value="passwordResetModel.ConfirmPassword"
                                  placeholder="確認のため再入力"
                                  data-testid="confirm-password-input" />
                        <ValidationMessage For="() => passwordResetModel.ConfirmPassword" class="text-danger" />
                    </div>

                    @if (passwordResetError != null)
                    {
                        <div class="alert alert-danger" role="alert" data-testid="password-reset-error">
                            <i class="fas fa-exclamation-circle"></i> @passwordResetError
                        </div>
                    }

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal"
                                disabled="@isResettingPassword">
                            <i class="fas fa-times"></i> キャンセル
                        </button>
                        <button type="submit"
                                class="btn btn-warning"
                                disabled="@isResettingPassword"
                                data-testid="execute-reset-button">
                            @if (isResettingPassword)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>リセット中...</span>
                            }
                            else
                            {
                                <i class="fas fa-unlock-alt"></i>
                                <span>リセット実行</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    // 【Blazor初学者向け解説】
    // [Parameter]属性: ルートパラメータをコンポーネントプロパティにバインドします。
    // {IdentityId}で定義されたルートパラメータが、このIdentityIdプロパティに自動的に設定されます。
    //
    // 【Phase B-F3 修正】
    // UserId（long型）からIdentityId（GUID文字列）に変更しました。
    // これにより、GetHashCode()による不安定な変換を回避し、確実にユーザーを特定できます。
    [Parameter]
    public string IdentityId { get; set; } = string.Empty;

    // 【Blazor初学者向け解説】
    // フォーム入力データを保持するモデルクラス
    // UI設計書3.8章に準拠した入力項目を定義
    public class EditUserModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty; // 表示のみ（変更不可）

        [Required(ErrorMessage = "ユーザー名は必須です")]
        [StringLength(50, ErrorMessage = "ユーザー名は50文字以内で入力してください")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "ロールを選択してください")]
        public string Role { get; set; } = string.Empty;

        public List<long> AssignedProjectIds { get; set; } = new();

        public bool IsActive { get; set; } = true;
    }

    // 【Blazor初学者向け解説】
    // パスワードリセット用のモデルクラス
    // モーダルフォーム内で使用
    public class PasswordResetModel
    {
        [Required(ErrorMessage = "新しいパスワードは必須です")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "パスワードは8文字以上100文字以内で入力してください")]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "パスワード確認は必須です")]
        [Compare(nameof(NewPassword), ErrorMessage = "パスワードが一致しません")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    // プロジェクト選択用の簡易DTO
    // 【Blazor初学者向け解説】
    // F# Domain層のProject型を、C# UIで扱いやすい形に変換したDTOです。
    // Project.Id.Value（ProjectId型のValue）とProject.Name.Value（ProjectName型のValue）を
    // 取り出して、シンプルなC#型に変換します。
    public class ProjectSelectionDto
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    // データ
    private EditUserModel model = new();
    private PasswordResetModel passwordResetModel = new();
    private List<ProjectSelectionDto> availableProjects = new();

    // 状態管理
    private bool loading = true;
    private bool isSubmitting = false;
    private bool isResettingPassword = false;
    private string? errorMessage = null;
    private string? passwordResetError = null;

    // 操作者情報（ASP.NET Core Identity ID）
    // 【Blazor初学者向け解説】
    // ASP.NET Core IdentityのユーザーID（文字列）を保持します。
    // GetHashCode()による変換は不安定なため、Identity IDを直接使用します。
    private string operatorIdentityId = string.Empty;
    private string operatorRole = string.Empty; // "SuperUser" or "ProjectManager"

    // 【Blazor初学者向け解説】
    // OnInitializedAsync: コンポーネント初期化時に呼び出される非同期メソッド
    // ルートパラメータで指定されたユーザーIDを使用して、対象ユーザー情報を取得します。
    // Phase B-F3 Stage4: AssignedProjectIds復元を実装
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // NameIdentifier claim から Identity ID（文字列）を取得
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && !string.IsNullOrEmpty(userIdClaim.Value))
            {
                operatorIdentityId = userIdClaim.Value;
            }

            // Role claim取得
            var roleClaim = user.FindFirst(System.Security.Claims.ClaimTypes.Role);
            if (roleClaim != null && !string.IsNullOrEmpty(roleClaim.Value))
            {
                operatorRole = roleClaim.Value;
            }

            // 対象ユーザー情報取得
            await LoadUserAsync();

            // プロジェクト一覧取得（権限フィルタ適用済み）
            // UI設計書3.8章: SuperUserは全プロジェクト、ProjectManagerは担当プロジェクトのみ
            await LoadProjectsAsync();

            loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = $"初期化エラー: {ex.Message}";
            loading = false;
            StateHasChanged();
        }
    }

    // プロジェクト一覧取得処理
    // 【Blazor初学者向け解説】
    // ProjectManagementServiceのGetProjectsAsyncメソッドを呼び出し、
    // 現在ユーザーの権限に応じたプロジェクト一覧を取得します。
    // SuperUserは全プロジェクト、ProjectManagerは担当プロジェクトのみが返されます。
    private async Task LoadProjectsAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // NameIdentifier claim から ASP.NET Core Identity ID（文字列）を取得
            var identityIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (identityIdClaim == null || string.IsNullOrEmpty(identityIdClaim.Value))
            {
                Console.WriteLine("警告: Identity IDを取得できませんでした");
                availableProjects = new List<ProjectSelectionDto>();
                return;
            }

            // Role claim取得（ProjectManagementService権限フィルタ用）
            var roleClaim = user.FindFirst(System.Security.Claims.ClaimTypes.Role);
            if (roleClaim == null || string.IsNullOrEmpty(roleClaim.Value))
            {
                Console.WriteLine("警告: ロール情報を取得できませんでした");
                availableProjects = new List<ProjectSelectionDto>();
                return;
            }

            // 【Blazor初学者向け解説】
            // F# Application層のGetProjectsQuery型を構築します。
            // UserId: string型で渡す（ASP.NET Core Identity IDをそのまま使用）
            // UserRole: F#のRole型（string→Role変換が必要）
            // SearchKeyword: F#のOption型（Microsoft.FSharp.Core.FSharpOption.None）

            // 【Issue #79 根本修正】ASP.NET Core Identity IDはstring型のまま使用
            // Guid変換は不要（GetProjectsQueryがstring型Identity IDを受け取るため）
            var operatorUserId = identityIdClaim.Value ?? string.Empty;

            // Role文字列をF# Role型に変換
            // 【Clean Architecture準拠】
            // RoleTypeConverter.FromString()でC# RoleType enumに変換後、
            // RoleTypeConverter.ToRole()でF# Domain.Role型に変換します。
            // これにより、Web層がDomain層を直接参照しません。
            var userRole = RoleTypeConverter.ToRole(RoleTypeConverter.FromString(roleClaim.Value ?? "GeneralUser"));

            // GetProjectsQuery構築
            // 【Blazor初学者向け解説】
            // F#レコードはC#からは位置引数で構築します。
            // パラメータ順序: UserId, UserRole, PageNumber, PageSize, IncludeInactive, SearchKeyword
            var query = new GetProjectsQuery(
                operatorUserId, // UserId: string（ASP.NET Core Identity ID）
                userRole,       // UserRole: Role
                1,              // PageNumber: int
                100,            // PageSize: int（最大100件 - Queries.fs制約準拠: PageSize 1-100）
                false,          // IncludeInactive: bool
                Microsoft.FSharp.Core.FSharpOption<string>.None  // SearchKeyword: string option
            );

            // 【Blazor初学者向け解説】
            // IProjectManagementServiceのGetProjectsAsyncを呼び出して
            // 権限フィルタ適用済みのプロジェクト一覧を取得します。
            // - SuperUser: 全プロジェクト表示
            // - ProjectManager: 担当プロジェクトのみ表示
            var result = await ProjectService.GetProjectsAsync(query);

            // 【Blazor初学者向け解説】
            // F# Result型のパターンマッチング:
            // - IsOk: 成功時、ResultValueからプロジェクト一覧（PagedResult<Project>）を取得
            // - IsError: 失敗時、ErrorValueからエラーメッセージを取得
            if (result.IsOk)
            {
                var pagedResult = result.ResultValue;

                // 【Blazor初学者向け解説】
                // F# List<Project>をC# List<ProjectSelectionDto>に変換します。
                // ProjectListResultDtoのProjectsフィールドからプロジェクト一覧を取得。
                // Microsoft.FSharp.Collections.FSharpList<T>はLINQメソッドを使用できます。
                // Project.Id.Value: ProjectId型のValue（long）
                // Project.Name.Value: ProjectName型のValue（string）
                availableProjects = pagedResult.Projects
                    .Select(project => new ProjectSelectionDto
                    {
                        Id = project.Id.Value,
                        Name = project.Name.Value
                    })
                    .ToList();

                Console.WriteLine($"プロジェクト一覧取得成功: {availableProjects.Count}件");
            }
            else
            {
                var errorMsg = result.ErrorValue;
                Console.WriteLine($"プロジェクト一覧取得エラー: {errorMsg}");

                // エラー時は空リスト
                availableProjects = new List<ProjectSelectionDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"プロジェクト一覧取得例外: {ex.Message}");
            availableProjects = new List<ProjectSelectionDto>();
        }
    }

    // ユーザー情報読み込み + AssignedProjectIds復元
    // 【Blazor初学者向け解説】
    // Phase B-F3 Stage4実装: GetProjectIdsByUserIdAsyncでプロジェクト割り当て情報を復元
    // これにより、チェックボックスの初期状態が正しく表示されます。
    //
    // 【Phase B-F3 修正】
    // IdentityId（GUID文字列）ベースでユーザーを取得します。
    // Application層にGetUserByIdentityIdAsyncメソッドがないため、
    // 一時的な回避策として、GetAllUsersWithIdentityAsyncで全ユーザーを取得し、
    // IdentityIdでフィルタして対象ユーザーを特定します。
    private async Task LoadUserAsync()
    {
        try
        {
            // 【Phase B-F3 修正】
            // GetAllUsersWithIdentityAsyncで全ユーザー（IdentityId付き）を取得
            // 返却値: Result<(User * string) list, string>
            var result = await UserManagementService.GetAllUsersWithIdentityAsync(new object(), operatorIdentityId, true);

            if (result.IsOk)
            {
                // F# list → C# array変換
                var userTuples = Microsoft.FSharp.Collections.ListModule.ToArray(result.ResultValue);

                // IdentityIdで対象ユーザーをフィルタ
                // タプル: t.Item1 = User, t.Item2 = IdentityId
                // 【C#初学者向け解説】
                // FirstOrDefault: 条件に一致する最初の要素を返す。なければdefault（参照型の場合はnull）
                var targetUserTuple = userTuples.FirstOrDefault(t => t.Item2 == IdentityId);

                // 【null安全性チェック】
                // タプル自体がnull（ユーザーが見つからない場合）をチェック
                if (targetUserTuple == null)
                {
                    errorMessage = "指定されたユーザーが見つかりませんでした";
                    return;
                }

                var user = targetUserTuple.Item1;

                // EditUserModelに変換
                model.UserId = user.Id.Value.ToString();
                model.Email = user.Email.Value;
                model.Name = user.Name.Value;
                model.Role = user.Role.ToString();
                model.IsActive = user.IsActive;

                // 🎯 Phase B-F3 Stage4: AssignedProjectIds復元
                // 【Blazor初学者向け解説】
                // IUserManagementService.GetProjectIdsByUserIdAsyncを使用して、
                // 既存のプロジェクト割り当て情報を取得します。
                // これにより、チェックボックスの初期状態が正しく復元されます。
                var projectIdsResult = await UserManagementService.GetProjectIdsByUserIdAsync(user.Id);
                if (projectIdsResult.IsOk)
                {
                    // 【Blazor初学者向け解説】
                    // F# Result型の成功値（ResultValue）からプロジェクトID一覧（FSharpList<long>）を取得します。
                    // F# list → C# List変換: Microsoft.FSharp.Collections.FSharpListはIEnumerableを実装しているため、
                    // LINQのToList()で直接変換できます。
                    var projectIds = projectIdsResult.ResultValue;
                    model.AssignedProjectIds = projectIds.ToList();
                }
                else
                {
                    // プロジェクトID取得失敗時は空リストで初期化（エラーログは既にApplication層で記録済み）
                    model.AssignedProjectIds = new List<long>();
                }
            }
            else
            {
                // エラー処理
                var error = result.ErrorValue;
                errorMessage = $"ユーザー取得エラー: {error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"ユーザー情報読み込みエラー: {ex.Message}";
        }
    }

    // プロジェクト選択トグル
    private void ToggleProject(long projectId, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked)
        {
            if (isChecked)
            {
                if (!model.AssignedProjectIds.Contains(projectId))
                {
                    model.AssignedProjectIds.Add(projectId);
                }
            }
            else
            {
                model.AssignedProjectIds.Remove(projectId);
            }
        }
    }

    // パスワードリセットモーダル表示
    // 【Blazor初学者向け解説】
    // Bootstrap 5のモーダルをJavaScript経由で表示します。
    // IJSRuntimeを使用してブラウザのJavaScript APIを呼び出します。
    private async Task ShowPasswordResetModal()
    {
        passwordResetModel = new PasswordResetModel(); // フォームリセット
        passwordResetError = null;
        await JSRuntime.InvokeVoidAsync("eval", "new bootstrap.Modal(document.getElementById('passwordResetModal')).show()");
    }

    // パスワードリセット実行
    // 【Blazor初学者向け解説】
    // Phase B-F3 Stage4実装: IUserManagementService.ResetPasswordAsyncを使用
    // SuperUserが他ユーザーのパスワードを強制的に変更します。
    // シグネチャ: ResetPasswordAsync(targetUserId: UserId, newPassword: string, operatorIdentityId: string) -> Task<Result<unit, string>>
    //
    // 【注意】
    // ResetPasswordAsyncはUserId（long）ベースのままです。
    // modelに保存されているUserIdを使用します。
    private async Task ExecutePasswordReset()
    {
        isResettingPassword = true;
        passwordResetError = null;
        StateHasChanged();

        try
        {
            // 【Blazor初学者向け解説】
            // F# UserId型の生成
            // modelに保存されているUserIdを使用（LoadUserAsyncで設定済み）
            // 【Issue #79 根本修正】UserId型はstring型に変更されたため、TryParseは不要
            if (string.IsNullOrEmpty(model.UserId))
            {
                passwordResetError = "ユーザーIDが無効です";
                isResettingPassword = false;
                StateHasChanged();
                return;
            }

            // 【Clean Architecture注記】
            // ResetPasswordAsyncがF# UserId型を要求するため、完全修飾名で参照します。
            // 将来的にApplication層がDTOを返すようになれば、この参照も解消できます。
            var targetId = UbiquitousLanguageManager.Domain.Common.UserId.NewUserId(model.UserId);

            // 【Blazor初学者向け解説】
            // IUserManagementService.ResetPasswordAsyncを呼び出します。
            // - targetUserId: 対象ユーザーID（F# Domain UserId型）
            // - newPassword: 新しいパスワード（バリデーション前の文字列）
            // - operatorIdentityId: 操作者のASP.NET Core Identity ID（文字列）
            // 権限チェックはApplication層で実施されます（SuperUserのみ実行可能）
            var result = await UserManagementService.ResetPasswordAsync(
                targetId,
                passwordResetModel.NewPassword,
                operatorIdentityId
            );

            if (result.IsOk)
            {
                // 成功: モーダルを閉じる
                await JSRuntime.InvokeVoidAsync("eval", "bootstrap.Modal.getInstance(document.getElementById('passwordResetModal')).hide()");
                await JSRuntime.InvokeVoidAsync("alert", "パスワードをリセットしました");

                isResettingPassword = false;
                StateHasChanged();
            }
            else
            {
                // エラー: モーダル内にエラーメッセージ表示
                var error = result.ErrorValue;
                passwordResetError = error;
                isResettingPassword = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            passwordResetError = $"予期しないエラー: {ex.Message}";
            isResettingPassword = false;
            StateHasChanged();
        }
    }

    // ユーザー更新処理
    private async Task UpdateUser()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            // 【Blazor初学者向け解説】
            // F# Application層のUpdateUserAsyncメソッドを呼び出します。
            //
            // 【Phase B-F3 修正】
            // UpdateUserAsyncはIdentityId（GUID文字列）ベースに変更されました。
            // IUserManagementService.UpdateUserAsync:
            //   targetIdentityId * name * role * assignedProjectIds * isActive * operatorIdentityId -> Task<Result<User, string>>
            var result = await UserManagementService.UpdateUserAsync(
                IdentityId,  // ASP.NET Core Identity ID（GUID文字列）
                model.Name,
                model.Role,
                Microsoft.FSharp.Collections.ListModule.OfSeq(model.AssignedProjectIds),
                model.IsActive,
                operatorIdentityId
            );

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("alert", "ユーザー情報を更新しました");
                Navigation.NavigateTo("/admin/users");
            }
            else
            {
                var error = result.ErrorValue;
                await JSRuntime.InvokeVoidAsync("alert", $"更新エラー: {error}");
                isSubmitting = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"予期しないエラー: {ex.Message}");
            isSubmitting = false;
            StateHasChanged();
        }
    }

