@page "/admin/users/create"
@using Microsoft.AspNetCore.Authorization
@using UbiquitousLanguageManager.Contracts.DTOs
@using UbiquitousLanguageManager.Domain.Common
@using UbiquitousLanguageManager.Application
@using System.ComponentModel.DataAnnotations
@attribute [Authorize(Roles = "SuperUser")]
@inject IUserManagementService UserManagementService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>ユーザー作成</PageTitle>

@* 【Blazor初学者向け解説】
   このコンポーネントは、新規ユーザーを作成する画面です。
   EditFormコンポーネントを使用して、入力検証と送信処理を実装します。
   DataAnnotationsValidatorにより、DTOに定義されたバリデーション属性が自動適用されます。
*@

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1><i class="fas fa-user-plus"></i> 新規ユーザー作成</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/admin/users">ユーザー管理</a></li>
                    <li class="breadcrumb-item active" aria-current="page">新規作成</li>
                </ol>
            </nav>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">読み込み中...</span>
            </div>
            <p class="mt-2">初期化中...</p>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 col-xl-6">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">ユーザー情報入力</h5>
                    </div>
                    <div class="card-body">
                        @* 【Blazor初学者向け解説】
                           EditForm: Blazorのフォームバリデーション機能を提供するコンポーネント
                           Model属性でバインドするモデルを指定します。
                           OnValidSubmit: バリデーション成功時のイベントハンドラー
                           OnInvalidSubmit: バリデーション失敗時のイベントハンドラー
                        *@
                        <EditForm Model="@model" OnValidSubmit="CreateUser" OnInvalidSubmit="OnInvalidSubmit">
                            @* 【Blazor初学者向け解説】
                               DataAnnotationsValidator: DataAnnotations属性を使用した自動検証コンポーネント
                               [Required]、[StringLength]、[EmailAddress]などの属性が自動的に評価されます。
                            *@
                            <DataAnnotationsValidator />

                            @* 【Blazor初学者向け解説】
                               ValidationSummary: すべてのバリデーションエラーを一覧表示するコンポーネント
                            *@
                            <ValidationSummary class="alert alert-danger" />

                            @* メールアドレス *@
                            <div class="mb-3">
                                <label for="email" class="form-label">メールアドレス <span class="text-danger">*</span></label>
                                <InputText id="email"
                                          class="form-control"
                                          @bind-Value="model.Email"
                                          placeholder="user@example.com"
                                          data-testid="input-email" />
                                <ValidationMessage For="() => model.Email" class="text-danger" />
                                <div class="form-text">ログインIDとして使用されます</div>
                            </div>

                            @* ユーザー名 *@
                            <div class="mb-3">
                                <label for="name" class="form-label">ユーザー名 <span class="text-danger">*</span></label>
                                <InputText id="name"
                                          class="form-control"
                                          @bind-Value="model.Name"
                                          placeholder="山田 太郎"
                                          data-testid="input-name" />
                                <ValidationMessage For="() => model.Name" class="text-danger" />
                                <div class="form-text">画面表示に使用される名前（50文字以内）</div>
                            </div>

                            @* 初期パスワード *@
                            <div class="mb-3">
                                <label for="password" class="form-label">初期パスワード <span class="text-danger">*</span></label>
                                <InputText id="password"
                                          type="password"
                                          class="form-control"
                                          @bind-Value="model.InitialPassword"
                                          placeholder="8文字以上"
                                          data-testid="input-password" />
                                <ValidationMessage For="() => model.InitialPassword" class="text-danger" />
                                <div class="form-text">
                                    <i class="fas fa-info-circle"></i> 8文字以上100文字以内で入力してください
                                </div>
                            </div>

                            @* ロール選択 *@
                            @* 【Blazor Server初学者向け解説】
                               InputRadio<TValue>のValue属性はTValue型（この場合string）
                               Value="SuperUser"と書くと変数SuperUserを探す
                               Value="@("SuperUser")"と書くと文字列リテラル"SuperUser"として解釈される

                               InputRadioGroup の Name 属性について:
                               - InputRadio に name 属性を指定する場合、親の InputRadioGroup にも同じ Name 属性が必要です
                               - これにより、HTML の <input type="radio" name="role"> が正しくグループ化されます
                               - Name 属性がないと、Blazor Server は InvalidOperationException をスローします *@
                            <div class="mb-3">
                                <label class="form-label">ユーザーロール <span class="text-danger">*</span></label>
                                <InputRadioGroup @bind-Value="model.Role" Name="role">
                                    <div class="form-check">
                                        <InputRadio id="role-superuser"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("SuperUser")"
                                                   data-testid="radio-role-superuser" />
                                        <label class="form-check-label" for="role-superuser">
                                            <span class="badge bg-danger">スーパーユーザー</span>
                                            - 全機能・全プロジェクトへのアクセス権限
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio id="role-projectmanager"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("ProjectManager")"
                                                   data-testid="radio-role-projectmanager" />
                                        <label class="form-check-label" for="role-projectmanager">
                                            <span class="badge bg-warning text-dark">プロジェクトマネージャー</span>
                                            - 割り当てプロジェクトの管理権限
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio id="role-domainapprover"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("DomainApprover")"
                                                   data-testid="radio-role-domainapprover" />
                                        <label class="form-check-label" for="role-domainapprover">
                                            <span class="badge bg-info text-dark">ドメイン承認者</span>
                                            - ユビキタス言語の承認権限
                                        </label>
                                    </div>
                                    <div class="form-check">
                                        <InputRadio id="role-generaluser"
                                                   class="form-check-input"
                                                   name="role"
                                                   Value="@("GeneralUser")"
                                                   data-testid="radio-role-generaluser" />
                                        <label class="form-check-label" for="role-generaluser">
                                            <span class="badge bg-secondary">一般ユーザー</span>
                                            - 基本的な参照・編集権限
                                        </label>
                                    </div>
                                </InputRadioGroup>
                                <ValidationMessage For="() => model.Role" class="text-danger" />
                            </div>

                            @* プロジェクト割り当て *@
                            <div class="mb-3">
                                <label class="form-label">割り当てプロジェクト（任意）</label>
                                <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;" data-testid="project-list">
                                    @if (availableProjects.Any())
                                    {
                                        @foreach (var project in availableProjects)
                                        {
                                            <div class="form-check">
                                                <input type="checkbox"
                                                       class="form-check-input"
                                                       id="project-@project.Id"
                                                       value="@project.Id"
                                                       checked="@model.AssignedProjectIds.Contains(project.Id)"
                                                       @onchange="e => ToggleProject(project.Id, e)"
                                                       data-testid="checkbox-project-@project.Id" />
                                                <label class="form-check-label" for="project-@project.Id">
                                                    @project.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">プロジェクトがありません</p>
                                    }
                                </div>
                                <div class="form-text">
                                    ユーザーがアクセスできるプロジェクトを選択してください（Phase B-F3 Step2で実装予定）
                                </div>
                            </div>

                            @* 送信ボタン *@
                            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                <button type="button" class="btn btn-secondary" @onclick="Cancel" data-testid="btn-cancel">
                                    <i class="fas fa-times"></i> キャンセル
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isSubmitting" data-testid="btn-submit">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>作成中...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-save"></i>
                                        <span>作成</span>
                                    }
                                </button>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // 【Blazor初学者向け解説】
    // フォーム入力データを保持するモデルクラス
    // DataAnnotations属性によるバリデーションルールを定義します。
    public class CreateUserModel
    {
        [Required(ErrorMessage = "メールアドレスは必須です")]
        [EmailAddress(ErrorMessage = "有効なメールアドレス形式で入力してください")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "ユーザー名は必須です")]
        [StringLength(50, ErrorMessage = "ユーザー名は50文字以内で入力してください")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "初期パスワードは必須です")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "パスワードは8文字以上100文字以内で入力してください")]
        public string InitialPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "ロールを選択してください")]
        public string Role { get; set; } = "GeneralUser"; // デフォルト値

        public List<long> AssignedProjectIds { get; set; } = new();
    }

    // プロジェクト選択用の簡易DTO
    public class ProjectSelectionDto
    {
        public long Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }

    // データ
    private CreateUserModel model = new();
    private List<ProjectSelectionDto> availableProjects = new();

    // 状態管理
    private bool loading = true;
    private bool isSubmitting = false;

    // 操作者情報（ASP.NET Core Identity ID）
    // 【Blazor初学者向け解説】
    // ASP.NET Core IdentityのユーザーID（文字列）を保持します。
    // GetHashCode()による変換は不安定なため、Identity IDを直接使用します。
    private string operatorIdentityId = string.Empty;

    // 【Blazor初学者向け解説】
    // OnInitializedAsync: コンポーネント初期化時の非同期処理
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // NameIdentifier claim から Identity ID（文字列）を取得
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier);
            if (userIdClaim != null && !string.IsNullOrEmpty(userIdClaim.Value))
            {
                operatorIdentityId = userIdClaim.Value;
            }

            // TODO: Phase B-F3 Step2でプロジェクト一覧取得API実装
            // 現時点ではダミーデータ
            availableProjects = new List<ProjectSelectionDto>();

            loading = false;

            // 【Blazor初学者向け解説】
            // StateHasChanged(): UI再描画を明示的に指示
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"初期化エラー: {ex.Message}");
            loading = false;
            StateHasChanged();
        }
    }

    // プロジェクト選択トグル
    private void ToggleProject(long projectId, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked)
        {
            if (isChecked)
            {
                if (!model.AssignedProjectIds.Contains(projectId))
                {
                    model.AssignedProjectIds.Add(projectId);
                }
            }
            else
            {
                model.AssignedProjectIds.Remove(projectId);
            }
        }
    }

    // ユーザー作成処理
    // 【Blazor初学者向け解説】
    // EditFormのOnValidSubmit属性で指定されたメソッド
    // バリデーション成功時に呼び出されます。
    private async Task CreateUser()
    {
        isSubmitting = true;
        StateHasChanged();

        try
        {
            // 【Blazor初学者向け解説】
            // F# Application層のCreateUserAsyncメソッドを呼び出します。
            // operatorIdentityId（ASP.NET Core Identity ID）を直接文字列として渡します。
            var result = await UserManagementService.CreateUserAsync(
                model.Email,
                model.Name,
                model.InitialPassword,
                model.Role,
                Microsoft.FSharp.Collections.ListModule.OfSeq(model.AssignedProjectIds),
                operatorIdentityId
            );

            // 【Blazor初学者向け解説】
            // F# Result型のIsOkプロパティで成功/失敗を判定
            if (result.IsOk)
            {
                // 成功: ユーザー一覧画面に遷移
                await JSRuntime.InvokeVoidAsync("alert", "ユーザーを作成しました");
                Navigation.NavigateTo("/admin/users");
            }
            else
            {
                // 失敗: エラーメッセージ表示
                var error = result.ErrorValue;
                await JSRuntime.InvokeVoidAsync("alert", $"作成エラー: {error}");
                isSubmitting = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"予期しないエラー: {ex.Message}");
            isSubmitting = false;
            StateHasChanged();
        }
    }

    // バリデーションエラー時の処理
    private void OnInvalidSubmit()
    {
        // ValidationSummaryが自動的にエラーを表示するため、特に処理不要
        // 必要に応じてログ出力などを追加
    }

    // キャンセル処理
    private void Cancel()
    {
        Navigation.NavigateTo("/admin/users");
    }
}
