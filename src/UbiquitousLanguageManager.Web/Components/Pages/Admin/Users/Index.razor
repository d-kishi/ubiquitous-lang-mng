    // ロールバッジクラス取得
    private string GetRoleBadgeClass(string role)
    {
        return role switch
        {
            "SuperUser" => "bg-danger",
            "ProjectManager" => "bg-warning text-dark",
            "DomainApprover" => "bg-info text-dark",
            "GeneralUser" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    // ロール表示名取得
    private string GetRoleDisplayName(string role)
    {
        return role switch
        {
            "SuperUser" => "スーパーユーザー",
            "ProjectManager" => "プロジェクトマネージャー",
            "DomainApprover" => "ドメイン承認者",
            "GeneralUser" => "一般ユーザー",
            _ => role
        };
    }
