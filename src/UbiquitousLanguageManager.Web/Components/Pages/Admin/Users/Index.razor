@page "/admin/users"
@using Microsoft.AspNetCore.Authorization
@using UbiquitousLanguageManager.Contracts.DTOs
@using UbiquitousLanguageManager.Contracts.Enums
@using UbiquitousLanguageManager.Contracts.TypeConverters
@using UbiquitousLanguageManager.Application
@using UbiquitousLanguageManager.Application.ProjectManagement
@using System.Security.Claims
@attribute [Authorize(Roles = "SuperUser,ProjectManager")]
@inject IUserManagementService UserManagementService
@inject IProjectManagementService ProjectManagementService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>ユーザー管理</PageTitle>

@* 【Blazor初学者向け解説】
   このコンポーネントは、ユーザー一覧を表示・検索・フィルタ・ページングする画面です。
   Blazor Serverでは、サーバー側でデータを取得し、SignalR接続を通じてクライアントに送信されます。

   UI設計書3.6章「ユーザー管理一覧画面」準拠:
   - SuperUser/ProjectManagerのみアクセス可能
   - SuperUser: 全ユーザー表示
   - ProjectManager: 自分が担当するプロジェクトに所属するユーザーのみ表示
   - FullHD（1920x1080）レイアウト対応（container-fluid）
   - 検索・プロジェクトフィルタ・削除済み表示・ページング機能
*@

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1><i class="fas fa-users"></i> ユーザー管理</h1>
        </div>
    </div>

    @* 検索・フィルタセクション *@
    <div class="row mb-3">
        @* 検索テキストボックス + ボタン *@
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text"
                       class="form-control"
                       placeholder="氏名で検索"
                       @bind="searchTerm"
                       @bind:event="oninput"
                       data-testid="user-search-input" />
                <button class="btn btn-outline-secondary"
                        @onclick="OnSearchButtonClicked"
                        data-testid="user-search-button">
                    検索
                </button>
            </div>
        </div>

        @* プロジェクトフィルタドロップダウン *@
        <div class="col-md-3">
            <select class="form-select"
                    @bind="selectedProjectId"
                    @bind:after="OnProjectFilterChanged"
                    data-testid="project-filter-dropdown">
                <option value="">全プロジェクト</option>
                @foreach (var project in availableProjects)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </div>

        @* 削除済みユーザー表示チェックボックス *@
        <div class="col-md-2">
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       id="showDeleted"
                       checked="@showDeleted"
                       @onchange="OnShowDeletedChanged"
                       data-testid="show-deleted-checkbox" />
                <label class="form-check-label" for="showDeleted">
                    削除済み表示
                </label>
            </div>
        </div>

        @* 新規ユーザー登録ボタン *@
        <div class="col-md-3 text-end">
            <button class="btn btn-primary"
                    @onclick="NavigateToCreate"
                    data-testid="create-user-button">
                <i class="fas fa-plus"></i> 新規ユーザー登録
            </button>
        </div>
    </div>

    @* データ読み込み中表示 *@
    @if (loading)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">読み込み中...</span>
            </div>
            <p class="mt-2">ユーザー一覧を読み込んでいます...</p>
        </div>
    }
    else if (errorMessage != null)
    {
        @* エラーメッセージ表示 *@
        <div class="alert alert-danger" role="alert">
            <i class="fas fa-exclamation-triangle"></i> @errorMessage
        </div>
    }
    else
    {
        @* ユーザー一覧テーブル *@
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">
                            ユーザー一覧
                            <span class="badge bg-secondary">@filteredUsers.Count 件</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover table-striped" data-testid="user-list-table">
                                <thead>
                                    <tr>
                                        <th scope="col">氏名</th>
                                        <th scope="col">メールアドレス</th>
                                        <th scope="col">権限レベル</th>
                                        <th scope="col">所属プロジェクト</th>
                                        <th scope="col">ステータス</th>
                                        <th scope="col">操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var user in paginatedUsers)
                                    {
                                        <tr data-testid="user-row-@user.Id">
                                            <td>@user.Name</td>
                                            <td>@user.Email</td>
                                            <td>
                                                <span class="badge @GetRoleBadgeClass(user.Role)">
                                                    @GetRoleDisplayName(user.Role)
                                                </span>
                                            </td>
                                            <td>
                                                @if (user.ProjectPermissions.Any())
                                                {
                                                    @* 所属プロジェクト名をカンマ区切りで表示 *@
                                                    <span>@GetProjectNames(user.ProjectPermissions)</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">なし</span>
                                                }
                                            </td>
                                            <td>
                                                @if (user.IsActive)
                                                {
                                                    <span class="badge bg-success">有効</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">無効</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-primary me-2"
                                                        @onclick="() => NavigateToEdit(user.IdentityId)"
                                                        data-testid="edit-user-button-@user.Id">
                                                    <i class="fas fa-edit"></i> 編集
                                                </button>
                                                @if (user.IsActive)
                                                {
                                                    <button class="btn btn-sm btn-danger"
                                                            @onclick="() => DeleteUser(user.IdentityId)"
                                                            data-testid="toggle-status-button-@user.Id">
                                                        <i class="fas fa-ban"></i> 削除
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @* ページング *@
                        @if (totalPages > 1)
                        {
                            <div class="row mt-3">
                                <div class="col-md-6">
                                    @* ページサイズ選択ドロップダウン *@
                                    <div class="d-flex align-items-center">
                                        <label class="me-2">表示件数:</label>
                                        <select class="form-select form-select-sm w-auto"
                                                @bind="pageSize"
                                                @bind:after="OnPageSizeChanged"
                                                data-testid="page-size-dropdown">
                                            <option value="50">50件</option>
                                            <option value="100">100件</option>
                                            <option value="200">200件</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    @* ページネーションコントロール *@
                                    <nav aria-label="ページネーション">
                                        <ul class="pagination justify-content-end mb-0">
                                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                                <button class="page-link"
                                                        @onclick="() => GoToPage(currentPage - 1)"
                                                        data-testid="pagination-prev"
                                                        disabled="@(currentPage == 1)">
                                                    前へ
                                                </button>
                                            </li>

                                            @* ページ番号ボタン（最大10ページ表示） *@
                                            @foreach (var pageNum in GetPageNumbers())
                                            {
                                                <li class="page-item @(currentPage == pageNum ? "active" : "")">
                                                    <button class="page-link"
                                                            @onclick="() => GoToPage(pageNum)"
                                                            data-testid="pagination-page-@pageNum">
                                                        @pageNum
                                                    </button>
                                                </li>
                                            }

                                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                                <button class="page-link"
                                                        @onclick="() => GoToPage(currentPage + 1)"
                                                        data-testid="pagination-next"
                                                        disabled="@(currentPage == totalPages)">
                                                    次へ
                                                </button>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // 【Blazor初学者向け解説】
    // @codeブロックは、Blazorコンポーネントのロジックを記述する場所です。
    // C#のクラスメンバーと同様に、フィールド・プロパティ・メソッドを定義できます。

    // データ
    private List<UserDto> allUsers = new();
    private List<UserDto> filteredUsers = new();
    private List<UserDto> paginatedUsers = new();
    private List<ProjectDto> availableProjects = new();
    private Dictionary<long, string> projectNameCache = new();

    // 検索・フィルタ
    private string searchTerm = string.Empty;
    private string selectedProjectId = string.Empty;
    private bool showDeleted = false;

    // ページング
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalPages = 1;

    // 状態管理
    private bool loading = true;
    private string? errorMessage = null;

    // 操作者情報
    // 【Issue #79 根本修正】UserId型はstring型に変更されました
    private string currentUserId = "0";
    private RoleType currentRole = RoleType.GeneralUser;
    private string operatorIdentityId = string.Empty;

    // 【Blazor初学者向け解説】
    // OnInitializedAsync: コンポーネント初期化時に一度だけ実行される非同期メソッド
    // 画面表示前のデータ取得・認証状態取得に使用します。
    // Blazor Serverでは、この処理中クライアントは待機状態になります。
    protected override async Task OnInitializedAsync()
    {
        try
        {
            // 【Blazor初学者向け解説】
            // AuthenticationStateProvider: ASP.NET Core Identityの認証状態を取得するサービス
            // Blazor Serverでは、サーバー側で認証状態が管理されます。
            var (userId, role, identityId) = await GetCurrentUserAsync();
            currentUserId = userId;
            currentRole = role;
            operatorIdentityId = identityId;

            // プロジェクト一覧取得（フィルタ用）
            await LoadProjectsAsync();

            // ユーザー一覧取得
            await LoadUsersAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"初期化エラー: {ex.Message}";
            loading = false;

            // 【Blazor初学者向け解説】
            // StateHasChanged(): UIを手動で再描画するメソッド
            // 非同期処理後、画面に変更を反映させるために明示的に呼び出します。
            // Blazor ServerはSignalR接続を通じてクライアントに変更を通知します。
            StateHasChanged();
        }
    }

    // 現在のユーザー情報取得
    // 【Blazor初学者向け解説】
    // ASP.NET Core IdentityのClaimsPrincipalから、ユーザーID・ロール・Identity IDを取得します。
    // 【Clean Architecture準拠】RoleTypeConverter.FromString()を使用してDomain層への直接参照を回避
    private async Task<(string userId, RoleType role, string identityId)> GetCurrentUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        // Identity ID取得（ASP.NET Core Identity GUID文字列）
        var identityId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";

        // ロール文字列取得
        // 【Blazor初学者向け解説】
        // RoleTypeConverter.FromString()を使用することで、Web層がDomain層を直接参照せず、
        // Contracts層のRoleType enumを使用してClean Architectureの依存関係を保ちます。
        var roleString = user.FindFirst(ClaimTypes.Role)?.Value ?? "GeneralUser";
        var role = RoleTypeConverter.FromString(roleString);

        // UserID取得（カスタムクレーム）
        // 【Issue #79 根本修正】UserId型はstring型に変更されたため、TryParseは不要
        var userIdString = user.FindFirst("UserId")?.Value ?? "0";

        return (userIdString, role, identityId);
    }

    // プロジェクト一覧取得
    // 【Blazor初学者向け解説】
    // GetProjectsAsyncメソッドを使用してプロジェクト一覧を取得します。
    // 権限制御統合済みで、SuperUserは全プロジェクト、ProjectManagerは担当プロジェクトのみ取得できます。
    private async Task LoadProjectsAsync()
    {
        try
        {
            // 【Issue #79 根本修正】ASP.NET Core Identity IDはstring型のまま使用
            // Guid変換は不要（GetProjectsQueryがstring型Identity IDを受け取るため）
            var operatorUserId = operatorIdentityId ?? string.Empty;

            // GetProjectsQuery構築
            // 【Blazor初学者向け解説】
            // F#レコードはC#からは位置引数で構築します（名前付き引数NG）。
            // パラメータ順序: UserId, UserRole, PageNumber, PageSize, IncludeInactive, SearchKeyword
            // 【Clean Architecture準拠】
            // RoleTypeConverter.ToRole()でC#のRoleType→F#のRoleに変換し、Application層に渡します。
            var query = new GetProjectsQuery(
                operatorUserId,                         // UserId: string（ASP.NET Core Identity ID）
                RoleTypeConverter.ToRole(currentRole),  // UserRole: Role（RoleType→Role変換）
                1,                                      // PageNumber: int
                100,                                    // PageSize: int（最大100件 - Queries.fs制約準拠: PageSize 1-100）
                false,                                  // IncludeInactive: bool
                Microsoft.FSharp.Core.FSharpOption<string>.None  // SearchKeyword
            );

            var result = await ProjectManagementService.GetProjectsAsync(query);

            if (result.IsOk)
            {
                // F# ProjectListResultDtoからプロジェクト一覧を取得
                // 【Blazor初学者向け解説】
                // GetProjectsAsyncはProjectListResultを返します。
                // ProjectListResult.Projects（F# Project list）をC#のProjectDtoに変換します。
                var projectListResult = result.ResultValue;
                var fsharpProjects = projectListResult.Projects;

                // F# Domain Project型からC# ProjectDtoへの変換
                // 【Blazor初学者向け解説】
                // F#の値オブジェクト（ProjectId, ProjectName, UserId等）は.Itemや.Valueで内部値を取得します。
                // FSharpOption<T>はSomeの場合は.Valueで取得、Noneの場合はnullとして扱います。
                availableProjects = fsharpProjects.Select(p => new ProjectDto
                {
                    Id = p.Id.Item,                    // ProjectId → long
                    Name = p.Name.Value,               // ProjectName → string
                    Description = Microsoft.FSharp.Core.FSharpOption<string>.get_IsSome(p.Description.Value)
                        ? p.Description.Value.Value : "", // ProjectDescription.Value (string option) → string
                    OwnerId = p.OwnerId.Item,          // UserId → long
                    IsActive = p.IsActive,
                    CreatedAt = p.CreatedAt,
                    UpdatedBy = "0",  // 【Issue #79 根本修正】string型に変更
                    UpdatedAt = Microsoft.FSharp.Core.FSharpOption<DateTime>.get_IsSome(p.UpdatedAt)
                        ? p.UpdatedAt.Value : (DateTime?)null
                }).ToList();

                // プロジェクト名キャッシュ構築
                projectNameCache = availableProjects.ToDictionary(p => p.Id, p => p.Name);
            }
        }
        catch (Exception ex)
        {
            // プロジェクト取得失敗時は空リストで継続（ユーザー一覧は表示）
            errorMessage = $"プロジェクト一覧取得エラー: {ex.Message}";
        }
    }

    // ユーザー一覧読み込み
    private async Task LoadUsersAsync()
    {
        loading = true;
        errorMessage = null;
        StateHasChanged(); // ローディング状態を即座に反映

        try
        {
            // 【Blazor初学者向け解説】
            // F# Result型のIsOk/ResultValueアクセスパターン
            // F# Application層から返されるResult型を、C#側で安全に処理します。
            // showDeletedフラグをサービスに渡すことで、削除済みユーザーを含めるかどうかを制御します。
            // チェックボックスの状態がサーバーサイドのデータ取得に反映されます。
            //
            // 【Phase B-F3 修正】
            // GetAllUsersWithIdentityAsyncを使用して、ASP.NET Core Identity ID（GUID文字列）を同時に取得します。
            // これにより、削除・編集操作でユーザーを確実に特定できます。
            // 返却値: Result<(User * string) list, string>
            // - (User * string): F#のタプル型。C#では.Item1（User）、.Item2（IdentityId）でアクセス
            var result = await UserManagementService.GetAllUsersWithIdentityAsync(new object(), operatorIdentityId, showDeleted);

            // 【Blazor初学者向け解説】
            // result.IsOk: F# Result型の成功判定プロパティ
            // 成功時はtrue、失敗時はfalseを返します。
            if (result.IsOk)
            {
                // 【Blazor初学者向け解説】
                // result.ResultValue: F# Result型から成功値を取得
                // F#のタプル型（User * string）をC#で扱う際は、.Item1（User）、.Item2（IdentityId）でアクセスします。
                // F# list → C# array変換: Microsoft.FSharp.Collections.ListModule.ToArray()
                var userTuples = Microsoft.FSharp.Collections.ListModule.ToArray(result.ResultValue);

                // タプル(User, IdentityId)からUserDtoへ変換
                // ConvertToDtoメソッドにUser（t.Item1）とIdentityId（t.Item2）を渡します。
                allUsers = userTuples.Select(t => ConvertToDto(t.Item1, t.Item2)).ToList();

                // 【Blazor初学者向け解説】
                // 【Phase B-F3 Step1.5 Stage4修正】
                // 各ユーザーのプロジェクト割り当て情報を取得
                // GetProjectIdsByUserIdAsyncの合成GUID問題を回避するため、Emailベースで取得
                // GetProjectIdsByEmailAsync: string → Result<int64 list, string>
                // Stage3.5申し送り事項: F# Result型のIsOk/ResultValue/ErrorValueアクセスパターン
                foreach (var user in allUsers)
                {
                    // Emailベースでプロジェクト情報を取得（合成GUID問題を回避）
                    var projectIdsResult = await UserManagementService.GetProjectIdsByEmailAsync(user.Email);

                    if (projectIdsResult.IsOk)
                    {
                        // F# list → C# array変換
                        var projectIds = Microsoft.FSharp.Collections.ListModule.ToArray(projectIdsResult.ResultValue);

                        // ProjectPermissionDto構築（プロジェクトIDのみ設定・権限リストは空）
                        user.ProjectPermissions = projectIds.Select(pid => new ProjectPermissionDto
                        {
                            ProjectId = pid,
                            Permissions = new List<string>()
                        }).ToList();
                    }
                    else
                    {
                        // エラー時は空リストを設定（画面は「なし」と表示）
                        user.ProjectPermissions = new List<ProjectPermissionDto>();
                    }
                }

                // 権限別フィルタリング
                allUsers = FilterUsersByRole(allUsers);

                ApplyFilters();
                loading = false;
                StateHasChanged();
            }
            else
            {
                // 【Blazor初学者向け解説】
                // result.ErrorValue: F# Result型からエラー値を取得
                // エラー情報をUIに表示します。
                var error = result.ErrorValue;
                errorMessage = $"ユーザー一覧取得エラー: {error}";
                loading = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"予期しないエラーが発生しました: {ex.Message}";
            loading = false;
            StateHasChanged();
        }
    }

    // 権限別ユーザーフィルタリング
    // 【UI設計書3.6章準拠】
    // - SuperUser: 全ユーザー表示
    // - ProjectManager: 自分が担当するプロジェクトに所属するユーザーのみ表示
    // 【Clean Architecture準拠】Contracts層のRoleTypeを使用
    private List<UserDto> FilterUsersByRole(List<UserDto> users)
    {
        if (currentRole == RoleType.SuperUser)
        {
            // SuperUserは全ユーザー表示
            return users;
        }
        else if (currentRole == RoleType.ProjectManager)
        {
            // ProjectManagerは自分が担当するプロジェクトに所属するユーザーのみ表示
            var myProjectIds = availableProjects.Select(p => p.Id).ToHashSet();
            return users.Where(u => u.ProjectPermissions.Any(pp => myProjectIds.Contains(pp.ProjectId))).ToList();
        }

        // それ以外（本来はアクセス不可）
        return new List<UserDto>();
    }

    // F# User → C# UserDtoへの変換（IdentityId付き）
    // 【Blazor初学者向け解説】
    // F#のドメインエンティティをC#のDTO（Data Transfer Object）に変換します。
    // F#のレコード型は、C#側からプロパティとしてアクセスできます。
    // ProjectPermissionsはLoadUsersAsync内で別途取得・設定されます。
    //
    // 【Phase B-F3 修正】
    // ASP.NET Core Identity ID（GUID文字列）をidentityIdパラメータとして受け取り、
    // UserDto.IdentityIdフィールドに設定します。
    // これにより、削除・編集操作でユーザーを確実に特定できます。
    private UserDto ConvertToDto(UbiquitousLanguageManager.Domain.Authentication.User user, string identityId)
    {
        return new UserDto
        {
            Id = user.Id.Value,
            IdentityId = identityId,  // ASP.NET Core Identity ID（GUID文字列）
            Email = user.Email.Value,
            Name = user.Name.Value,
            Role = user.Role.ToString(),
            IsActive = user.IsActive,
            IsFirstLogin = user.IsFirstLogin,
            CreatedAt = user.CreatedAt,
            CreatedBy = user.CreatedBy.Value,
            UpdatedAt = user.UpdatedAt,
            UpdatedBy = user.UpdatedBy.Value,
            ProjectPermissions = new List<ProjectPermissionDto>() // LoadUsersAsyncで設定
        };
    }

    // 検索・フィルタ適用
    private void ApplyFilters()
    {
        // 検索フィルタ
        filteredUsers = allUsers.Where(u =>
        {
            // 氏名の部分一致検索
            var matchesSearch = string.IsNullOrWhiteSpace(searchTerm) ||
                                u.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase);

            // 【Blazor初学者向け解説】
            // 削除済みフィルタはサーバーサイド（UserRepository.GetAllUsersAsync）で
            // includeDeletedパラメータにより適用済みのため、クライアントサイドでは実施しません。
            // これにより、showDeletedチェックボックスの状態がサーバーサイドのデータ取得に
            // 正しく反映されます。

            // プロジェクトフィルタ
            var matchesProject = string.IsNullOrWhiteSpace(selectedProjectId) ||
                                 u.ProjectPermissions.Any(pp => pp.ProjectId.ToString() == selectedProjectId);

            return matchesSearch && matchesProject;
        }).ToList();

        // ページング再計算
        CalculatePagination();
    }

    // ページング再計算
    private void CalculatePagination()
    {
        totalPages = (int)Math.Ceiling((double)filteredUsers.Count / pageSize);
        currentPage = Math.Min(currentPage, Math.Max(1, totalPages));

        paginatedUsers = filteredUsers
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    // 検索ボタンクリックイベント
    private void OnSearchButtonClicked()
    {
        ApplyFilters();
        StateHasChanged();
    }

    // プロジェクトフィルタ変更イベント
    // 【Blazor初学者向け解説】
    // @bind:after により、selectedProjectId バインディング完了後に自動的に呼び出されます
    private void OnProjectFilterChanged()
    {
        currentPage = 1;
        ApplyFilters();
        StateHasChanged();
    }

    // 削除済みユーザー表示切替イベント
    // 【Blazor初学者向け解説】
    // チェックボックスの@onchangeイベントハンドラ
    // checked属性と@onchangeを組み合わせた手動バインディングパターンです。
    // showDeletedフラグはサーバーサイドでのフィルタリングに使用されるため、
    // データの再取得（LoadUsersAsync）が必要です。
    private async Task OnShowDeletedChanged(ChangeEventArgs e)
    {
        // チェックボックスの値をbool型に変換して更新
        showDeleted = (bool)(e.Value ?? false);
        currentPage = 1;

        // 【Blazor初学者向け解説】
        // showDeletedフラグがサービス呼び出しに渡されるため、
        // サーバーサイドで削除済みユーザーを含める/除外するには
        // データの再取得が必要です。
        await LoadUsersAsync();
    }

    // ページサイズ変更イベント
    private void OnPageSizeChanged()
    {
        currentPage = 1;
        CalculatePagination();
        StateHasChanged();
    }

    // ページ移動
    private void GoToPage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            CalculatePagination();
            StateHasChanged();
        }
    }

    // ページ番号リスト取得（最大10ページ表示）
    private IEnumerable<int> GetPageNumbers()
    {
        const int maxDisplayPages = 10;
        int startPage = Math.Max(1, currentPage - maxDisplayPages / 2);
        int endPage = Math.Min(totalPages, startPage + maxDisplayPages - 1);

        // 開始ページ調整（終了ページが最大表示数に満たない場合）
        if (endPage - startPage + 1 < maxDisplayPages)
        {
            startPage = Math.Max(1, endPage - maxDisplayPages + 1);
        }

        return Enumerable.Range(startPage, endPage - startPage + 1);
    }

    // 所属プロジェクト名取得（カンマ区切り）
    private string GetProjectNames(List<ProjectPermissionDto> permissions)
    {
        var names = permissions
            .Where(pp => projectNameCache.ContainsKey(pp.ProjectId))
            .Select(pp => projectNameCache[pp.ProjectId])
            .ToList();

        return names.Any() ? string.Join(", ", names) : "不明";
    }

    // ユーザー削除
    // 【Phase B-F3 修正】
    // UserId（long）ではなくIdentityId（GUID文字列）を使用します。
    // これにより、GetHashCode()による不安定な変換を回避し、確実にユーザーを特定できます。
    private async Task DeleteUser(string identityId)
    {
        // 【Blazor初学者向け解説】
        // IJSRuntime: Blazor ServerとJavaScriptの相互運用を提供するサービス
        // ブラウザのJavaScript関数を呼び出すことができます。
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"このユーザーを削除してもよろしいですか？");
        if (!confirmed) return;

        try
        {
            // 【Phase B-F3 修正】
            // DeleteUserAsyncの引数をIdentityId（string）ベースに変更
            // IUserManagementService.DeleteUserAsync: targetIdentityId * operatorIdentityId -> Task<Result<unit, string>>
            var result = await UserManagementService.DeleteUserAsync(identityId, operatorIdentityId);

            if (result.IsOk)
            {
                await JSRuntime.InvokeVoidAsync("alert", "ユーザーを削除しました");
                await LoadUsersAsync();
            }
            else
            {
                var error = result.ErrorValue;
                await JSRuntime.InvokeVoidAsync("alert", $"削除エラー: {error}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"エラー: {ex.Message}");
        }
    }

