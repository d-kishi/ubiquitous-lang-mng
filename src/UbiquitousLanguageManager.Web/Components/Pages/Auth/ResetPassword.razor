@page "/reset-password"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using UbiquitousLanguageManager.Contracts.Interfaces
@using UbiquitousLanguageManager.Contracts.DTOs.Common
@using Microsoft.Extensions.Logging
@attribute [AllowAnonymous]
@layout EmptyLayout
@inject IPasswordResetService PasswordResetService
@inject NavigationManager NavigationManager
@inject ILogger<ResetPassword> Logger

<PageTitle>新しいパスワードの設定</PageTitle>

<div class="container-fluid d-flex align-items-center justify-content-center min-vh-100 bg-light">
    <div class="row w-100">
        <div class="col-12 col-md-8 col-lg-6 col-xl-4 mx-auto">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-key fa-3x text-primary mb-3"></i>
                        <h1 class="h3">新しいパスワードの設定</h1>
                        <p class="text-muted">新しいパスワードを入力してください</p>
                    </div>

                    @if (isLoading)
                    {
                        <!-- トークン検証中のローディング表示 -->
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">検証中...</span>
                            </div>
                            <p class="mt-3 text-muted">リセットリンクを検証しています...</p>
                        </div>
                    }
                    else if (!isTokenValid)
                    {
                        <!-- 無効トークンメッセージ -->
                        <div class="alert alert-danger" role="alert" data-testid="reset-password-invalid-token-message">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>リセットリンクが無効または期限切れです</strong>
                            <p class="mb-0 mt-2">
                                パスワードリセットリンクの有効期限は24時間です。<br />
                                再度パスワードリセットを申請してください。
                            </p>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="button" class="btn btn-secondary" @onclick="GoToForgotPassword" data-testid="reset-password-cancel-button">
                                <i class="fas fa-arrow-left me-2"></i>
                                パスワードリセット申請へ
                            </button>
                        </div>
                    }
                    else if (isSuccess)
                    {
                        <!-- 成功メッセージ（3秒後に自動遷移） -->
                        <div class="alert alert-success" role="alert" data-testid="reset-password-success-message">
                            <i class="fas fa-check-circle me-2"></i>
                            <strong>パスワードを変更しました</strong>
                            <p class="mb-0 mt-2">
                                ログイン画面に移動します...
                            </p>
                        </div>
                        <div class="text-center">
                            <div class="spinner-border text-success spinner-border-sm" role="status">
                                <span class="visually-hidden">リダイレクト中...</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- パスワードリセットフォーム -->
                        <EditForm Model="model" OnValidSubmit="HandleValidSubmitAsync" FormName="ResetPasswordForm">
                            <DataAnnotationsValidator />

                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <div class="alert alert-danger alert-dismissible fade show" role="alert" data-testid="reset-password-error-message">
                                    <i class="fas fa-exclamation-circle me-2"></i>
                                    @errorMessage
                                    <button type="button" class="btn-close" @onclick="@(() => errorMessage = null)"></button>
                                </div>
                            }

                            <!-- 新しいパスワード入力 -->
                            <div class="mb-3">
                                <label for="new-password" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    新しいパスワード
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText
                                    type="password"
                                    id="new-password"
                                    class="form-control"
                                    @bind-Value="model.NewPassword"
                                    placeholder="8文字以上で入力してください"
                                    disabled="@isSubmitting"
                                    data-testid="reset-password-new-input" />
                                <ValidationMessage For="@(() => model.NewPassword)" class="text-danger" />
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1"></i>
                                    パスワードは8文字以上、数字と小文字を含む必要があります
                                </div>
                            </div>

                            <!-- パスワード確認入力 -->
                            <div class="mb-4">
                                <label for="confirm-password" class="form-label">
                                    <i class="fas fa-lock me-1"></i>
                                    パスワード確認
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText
                                    type="password"
                                    id="confirm-password"
                                    class="form-control"
                                    @bind-Value="model.ConfirmPassword"
                                    placeholder="確認のため再入力してください"
                                    disabled="@isSubmitting"
                                    data-testid="reset-password-confirm-input" />
                                <ValidationMessage For="@(() => model.ConfirmPassword)" class="text-danger" />
                            </div>

                            <!-- 送信ボタン -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg" disabled="@isSubmitting" data-testid="reset-password-submit-button">
                                    @if (isSubmitting)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                        <span>処理中...</span>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check me-2"></i>
                                        <span>パスワードを変更</span>
                                    }
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="GoToLogin" disabled="@isSubmitting" data-testid="reset-password-cancel-button">
                                    <i class="fas fa-times me-2"></i>
                                    キャンセル
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    /// <summary>
    /// パスワードリセット用モデルクラス
    ///
    /// 【Blazor Server初学者向け解説】
    /// EditFormでバリデーションを行うためのモデルクラスです。
    /// DataAnnotations属性により、クライアント側での入力検証が自動的に行われます。
    /// </summary>
    private class ResetPasswordModel
    {
        [Required(ErrorMessage = "新しいパスワードを入力してください")]
        [StringLength(100, MinimumLength = 8, ErrorMessage = "パスワードは8文字以上で入力してください")]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "確認用パスワードを入力してください")]
        [Compare(nameof(NewPassword), ErrorMessage = "パスワードが一致しません")]
        [DataType(DataType.Password)]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    /// <summary>
    /// クエリパラメータ: メールアドレス
    ///
    /// 【Blazor Server初学者向け解説】
    /// [SupplyParameterFromQuery]属性により、URLクエリパラメータから自動的に値が設定されます。
    /// 例: /reset-password?email=user@example.com (tokenパラメータも同様)
    /// </summary>
    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    /// <summary>
    /// クエリパラメータ: リセットトークン
    /// </summary>
    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetPasswordModel model = new();
    private bool isLoading = true;
    private bool isTokenValid = false;
    private bool isSubmitting = false;
    private bool isSuccess = false;
    private string? errorMessage = null;

    /// <summary>
    /// コンポーネント初期化処理
    ///
    /// 【Blazor Server初学者向け解説】
    /// OnInitializedAsync()はBlazor Serverコンポーネントのライフサイクルメソッドです。
    /// コンポーネントが初期化される際に一度だけ実行され、非同期処理（データ取得等）を行います。
    ///
    /// 【処理フロー】
    /// 1. クエリパラメータ（email, token）の検証
    /// 2. IPasswordResetService.ValidateResetTokenAsync()でトークン有効性確認
    /// 3. 有効な場合はフォーム表示、無効な場合はエラーメッセージ表示
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // セキュリティログ: パスワードリセット画面アクセス
        // 【重要】email/tokenは機密情報のためマスキング
        Logger.LogInformation("パスワードリセット画面アクセス Email: {EmailMasked}, Token: {TokenMasked}",
            MaskEmail(Email),
            Token != null ? "***" : "(null)");

        // クエリパラメータのバリデーション
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            Logger.LogWarning("パスワードリセット: 無効なパラメータ Email: {Email}, Token: {Token}",
                Email ?? "(null)",
                Token != null ? "***" : "(null)");

            isLoading = false;
            isTokenValid = false;
            StateHasChanged(); // UI再描画
            return;
        }

        // トークン検証
        try
        {
            var result = await PasswordResetService.ValidateResetTokenAsync(Email, Token);

            // 【F#初学者向け解説】
            // ResultDto<bool>は、F# Result型を模倣したC#のDTOです。
            // IsSuccessプロパティで成功・失敗を判定し、Value/Errorプロパティでデータを取得します。
            if (result.IsSuccess && result.Value == true)
            {
                isTokenValid = true;
            }
            else
            {
                Logger.LogWarning("パスワードリセット: トークン検証失敗 Email: {EmailMasked}, Error: {Error}",
                    MaskEmail(Email),
                    result.Error);
                isTokenValid = false;
            }

            if (isTokenValid)
            {
                Logger.LogInformation("パスワードリセット: トークン検証成功 Email: {EmailMasked}", MaskEmail(Email));
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワードリセット: トークン検証中に例外発生 Email: {EmailMasked}", MaskEmail(Email));
            isTokenValid = false;
        }
        finally
        {
            isLoading = false;
            StateHasChanged(); // UI再描画
        }
    }

    /// <summary>
    /// フォーム送信処理
    ///
    /// 【Blazor Server初学者向け解説】
    /// EditFormのOnValidSubmitイベントで呼び出されます。
    /// DataAnnotationsValidatorによるバリデーションが成功した場合のみ実行されます。
    ///
    /// 【処理フロー】
    /// 1. IPasswordResetService.ResetPasswordAsync()でパスワードリセット実行
    /// 2. 成功時: 成功メッセージ表示 → 3秒後にログイン画面へ自動遷移
    /// 3. 失敗時: エラーメッセージ表示
    /// </summary>
    private async Task HandleValidSubmitAsync()
    {
        if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Token))
        {
            errorMessage = "セッションが無効です。再度パスワードリセットを申請してください。";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        StateHasChanged(); // UI再描画

        try
        {
            Logger.LogInformation("パスワードリセット実行開始 Email: {EmailMasked}", MaskEmail(Email));

            var result = await PasswordResetService.ResetPasswordAsync(Email, Token, model.NewPassword);

            // Railway-oriented Programming パターン: IsSuccessで成功・失敗を判定
            if (result.IsSuccess)
            {
                Logger.LogInformation("パスワードリセット成功 Email: {EmailMasked}", MaskEmail(Email));
                isSuccess = true;
                StateHasChanged(); // UI再描画

                // 3秒後にログイン画面へ自動遷移
                // 【Blazor Server初学者向け解説】
                // Task.Delay()で非同期待機し、NavigationManager.NavigateTo()でページ遷移を実行します。
                // forceLoad: trueにより、Blazor Router経由ではなくブラウザの完全リロードを実行します。
                _ = Task.Delay(3000).ContinueWith(_ =>
                {
                    NavigationManager.NavigateTo("/login", forceLoad: true);
                });
            }
            else
            {
                Logger.LogWarning("パスワードリセット失敗 Email: {EmailMasked}, Error: {Error}",
                    MaskEmail(Email),
                    result.Error);
                errorMessage = result.Error;
                StateHasChanged(); // UI再描画
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "パスワードリセット中に例外発生 Email: {EmailMasked}", MaskEmail(Email));
            errorMessage = "パスワードのリセット中にエラーが発生しました。時間をおいて再度お試しください。";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged(); // UI再描画（最終確認）
        }
    }

    /// <summary>
    /// ログイン画面へ遷移
    /// </summary>
    private void GoToLogin()
    {
        Logger.LogInformation("パスワードリセット画面からログイン画面へ遷移");
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }

    /// <summary>
    /// パスワードリセット申請画面へ遷移
    /// </summary>
    private void GoToForgotPassword()
    {
        Logger.LogInformation("パスワードリセット画面からパスワードリセット申請画面へ遷移");
        NavigationManager.NavigateTo("/forgot-password", forceLoad: true);
    }

    /// <summary>
    /// メールアドレスをマスキング
    ///
    /// 【セキュリティ対策】
    /// ログにメールアドレスを出力する際、個人情報保護のため部分的にマスキングします。
    /// 例: user@example.com → u***@example.com
    /// </summary>
    private string MaskEmail(string? email)
    {
        if (string.IsNullOrEmpty(email)) return "(null)";

        var atIndex = email.IndexOf('@');
        if (atIndex <= 0) return "***";

        var localPart = email.Substring(0, atIndex);
        var domainPart = email.Substring(atIndex);

        return localPart.Length <= 1
            ? $"{localPart}***{domainPart}"
            : $"{localPart[0]}***{domainPart}";
    }
}

@*
【UI設計書3.5節準拠】パスワードリセット実行画面

【画面仕様】
- 画面タイトル: 「新しいパスワードの設定」
- 入力項目: 新しいパスワード（必須・強度チェック）、パスワード確認（必須・一致確認）
- 実行ボタン: 「パスワードを変更」
- キャンセルボタン: 「キャンセル」（/loginへ遷移）
- 成功メッセージ: 「パスワードを変更しました。ログイン画面に移動します。」→自動遷移
- 無効トークン: 「リセットリンクが無効または期限切れです」
- バリデーション: パスワード強度要件・確認一致
- レイアウト: サイドメニューなし・中央配置
- アクセス: メールリンクから（クエリパラメータ: email, token）

【技術実装】
1. @layout EmptyLayout: サイドバーなしレイアウト適用
2. [AllowAnonymous]: 未認証ユーザーアクセス許可
3. [SupplyParameterFromQuery]: URL クエリパラメータ自動バインディング
4. OnInitializedAsync(): トークン検証（IPasswordResetService.ValidateResetTokenAsync）
5. HandleValidSubmitAsync(): パスワードリセット実行（IPasswordResetService.ResetPasswordAsync）
6. StateHasChanged(): Blazor Server UI再描画（非同期処理後必須）
7. data-testid属性: E2Eテスト用セレクター（Playwright Test統合）
8. セキュリティログ: メールアドレス・トークンマスキング（個人情報保護）

【画面状態管理】
1. 初期ローディング: トークン検証中（スピナー表示）
2. 無効トークン: エラーメッセージ・フォーム非表示
3. 有効トークン: フォーム表示
4. 成功: 成功メッセージ → 3秒後にログイン画面へ自動遷移

【Blazor Server初学者向け重要ポイント】
- OnInitializedAsync()は初回レンダリング前に一度だけ実行される
- StateHasChanged()は非同期処理後のUI更新に必須
- NavigationManager.NavigateTo()でページ遷移（forceLoad: trueで完全リロード）
- EditForm + DataAnnotationsValidatorでクライアント側バリデーション自動実行
- ILogger<T>で構造化ログ出力（ASP.NET Core統合）
*@
