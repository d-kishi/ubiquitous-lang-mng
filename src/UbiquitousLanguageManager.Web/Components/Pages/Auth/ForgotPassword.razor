@page "/forgot-password"
@layout EmptyLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using UbiquitousLanguageManager.Contracts.Interfaces
@inject IPasswordResetService PasswordResetService
@inject NavigationManager NavigationManager
@inject ILogger<ForgotPassword> Logger

<PageTitle>パスワードリセット</PageTitle>

<div class="container-fluid vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row w-100">
        <div class="col-lg-4 col-md-6 col-sm-8 mx-auto">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fas fa-key fa-3x text-primary mb-3"></i>
                        <h2 class="h3 mb-2">パスワードリセット</h2>
                        <p class="text-muted">登録されたメールアドレスにリセットリンクを送信します</p>
                    </div>

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" data-testid="forgot-password-success-message">
                            <i class="fas fa-check-circle me-2"></i>
                            @successMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" data-testid="forgot-password-error-message">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="閉じる"></button>
                        </div>
                    }

                    @* Blazor Server初学者向け解説:
                        EditForm - Blazor Serverのフォームコンポーネント
                        - Model: バインディング対象のモデル（ここではFormModel）
                        - OnValidSubmit: バリデーション成功時のハンドラ
                        - OnInvalidSubmit: バリデーション失敗時のハンドラ
                    *@
                    <EditForm Model="@formModel" OnValidSubmit="HandleValidSubmitAsync" OnInvalidSubmit="HandleInvalidSubmit">
                        @* Blazor Server初学者向け解説:
                            DataAnnotationsValidator - DataAnnotations属性によるバリデーションを有効化
                            FormModelの[Required][EmailAddress]属性が自動的に検証される
                        *@
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="fas fa-envelope me-1"></i>
                                メールアドレス
                            </label>
                            @* Blazor Server初学者向け解説:
                                InputText - Blazor Serverの入力コンポーネント
                                - @bind-Value: 双方向データバインディング（フォームモデルと同期）
                                - class: Bootstrap 5のスタイル適用
                                - data-testid: E2Eテスト用の一意識別子
                            *@
                            <InputText id="email"
                                       @bind-Value="formModel.Email"
                                       class="form-control form-control-lg"
                                       placeholder="example@example.com"
                                       data-testid="forgot-password-email-input" />
                            @* Blazor Server初学者向け解説:
                                ValidationMessage - 特定フィールドのバリデーションエラーを表示
                                - For: ラムダ式でバインディング対象プロパティを指定
                            *@
                            <ValidationMessage For="@(() => formModel.Email)" class="text-danger small mt-1" />
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit"
                                    class="btn btn-primary btn-lg"
                                    disabled="@isSubmitting"
                                    data-testid="forgot-password-submit-button">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>送信中...</span>
                                }
                                else
                                {
                                    <i class="fas fa-paper-plane me-2"></i>
                                    <span>リセットリンクを送信</span>
                                }
                            </button>
                        </div>

                        <div class="d-grid">
                            <a href="/login"
                               class="btn btn-outline-secondary"
                               data-testid="forgot-password-back-button">
                                <i class="fas fa-arrow-left me-2"></i>
                                ログイン画面に戻る
                            </a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    // Blazor Server初学者向け解説:
    // フォームモデルクラス - DataAnnotations属性による宣言的バリデーション
    private FormModel formModel = new();
    private string? successMessage;
    private string? errorMessage;
    private bool isSubmitting = false;

    /// <summary>
    /// フォームモデル定義
    /// Blazor Server初学者向け解説:
    /// DataAnnotations属性により、クライアントサイド・サーバーサイドの両方で
    /// バリデーションが自動的に実行されます。
    /// </summary>
    private class FormModel
    {
        [Required(ErrorMessage = "メールアドレスは必須です")]
        [EmailAddress(ErrorMessage = "有効なメールアドレスを入力してください")]
        public string Email { get; set; } = string.Empty;
    }

    /// <summary>
    /// バリデーション成功時の処理
    /// Blazor Server初学者向け解説:
    /// - async/await: 非同期処理パターン（Blazor ServerではUI更新を待機しながら実行）
    /// - StateHasChanged(): Blazor Serverに画面再描画を指示（自動呼び出しもあるが、明示的に呼ぶことで確実に更新）
    /// </summary>
    private async Task HandleValidSubmitAsync()
    {
        // エラー・成功メッセージをクリア
        errorMessage = null;
        successMessage = null;
        isSubmitting = true;
        StateHasChanged(); // UI更新（送信中スピナー表示）

        try
        {
            // セキュリティログ: メールアドレスをマスキング（個人情報保護）
            // Blazor Server初学者向け解説:
            // ILoggerはASP.NET Core標準のログ機構で、構造化ログを出力します。
            // メールアドレスはマスキングして記録することで、個人情報漏洩を防止します。
            Logger.LogInformation("パスワードリセット申請: Email={MaskedEmail}", MaskEmail(formModel.Email));

            // Blazor Server初学者向け解説:
            // IPasswordResetServiceはDI（依存性注入）により提供され、
            // Infrastructure層のPasswordResetServiceがClean Architectureに基づき実装を提供します。
            var result = await PasswordResetService.RequestPasswordResetAsync(formModel.Email);

            // Blazor Server初学者向け解説:
            // ResultDto.IsSuccess - F# Railway-oriented Programmingパターンの成功/失敗判定
            // Infrastructure層でのエラーも型安全に処理されます。
            if (result.IsSuccess)
            {
                successMessage = "パスワードリセットのリンクをメールで送信しました。";
                formModel.Email = string.Empty; // フォームクリア

                Logger.LogInformation("パスワードリセット申請成功: Email={MaskedEmail}", MaskEmail(formModel.Email));
            }
            else
            {
                errorMessage = result.Error ?? "パスワードリセット申請に失敗しました。もう一度お試しください。";

                Logger.LogWarning("パスワードリセット申請失敗: Email={MaskedEmail}, Error={Error}",
                    MaskEmail(formModel.Email), result.Error);
            }
        }
        catch (Exception ex)
        {
            // 予期しない例外処理
            errorMessage = "システムエラーが発生しました。しばらくしてからもう一度お試しください。";

            Logger.LogError(ex, "パスワードリセット申請中に予期しないエラー: Email={MaskedEmail}",
                MaskEmail(formModel.Email));
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged(); // UI更新（送信完了・エラー表示）
        }
    }

    /// <summary>
    /// バリデーション失敗時の処理
    /// Blazor Server初学者向け解説:
    /// EditFormのOnInvalidSubmitイベントで呼ばれます。
    /// ValidationMessageコンポーネントが自動的にエラーを表示するため、
    /// ここでは追加の処理は不要ですが、ログ記録のために定義しています。
    /// </summary>
    private void HandleInvalidSubmit()
    {
        Logger.LogDebug("パスワードリセット申請バリデーションエラー");
    }

    /// <summary>
    /// ログイン画面に戻る
    /// Blazor Server初学者向け解説:
    /// NavigationManagerはBlazor Serverのルーティング管理サービスで、
    /// クライアントサイドのSPA的な画面遷移を実現します（ページ再読み込みなし）。
    /// </summary>
    private void NavigateToLogin()
    {
        NavigationManager.NavigateTo("/login");
    }

    /// <summary>
    /// メールアドレスマスキング（セキュリティログ用）
    /// Blazor Server初学者向け解説:
    /// 個人情報保護のため、ログ出力時にメールアドレスの一部を隠します。
    /// 例: example@example.com → exa***@example.com
    /// </summary>
    private static string MaskEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return "***";
        }

        var atIndex = email.IndexOf('@');
        if (atIndex <= 0)
        {
            return "***";
        }

        var localPart = email.Substring(0, atIndex);
        var domainPart = email.Substring(atIndex);

        // ローカルパートの最初の3文字以降をマスキング
        var masked = localPart.Length > 3
            ? localPart.Substring(0, 3) + "***"
            : "***";

        return masked + domainPart;
    }
}

@*
【Blazor Server初学者向け - このコンポーネントの全体像】

1. ライフサイクル:
   - このコンポーネントはステートフルで、Blazor Serverのサーキット内で動作します
   - SignalR接続により、サーバー側の状態変更がリアルタイムでクライアントに反映されます

2. データバインディング:
   - @bind-Valueにより、InputTextとFormModel.Emailが双方向同期
   - StateHasChanged()により、明示的なUI再描画をトリガー

3. Clean Architecture統合:
   - IPasswordResetServiceはContracts層で定義され、Infrastructure層で実装
   - Result型により、エラーハンドリングが型安全に行われる

4. セキュリティ:
   - [AllowAnonymous]属性により、認証なしでアクセス可能（パスワードリセット画面のため）
   - メールアドレスのマスキングにより、ログからの個人情報漏洩を防止
   - CSRF保護はEmptyLayoutのauth-api.jsで自動適用

5. UX設計:
   - 送信中はスピナー表示（isSubmittingフラグ）
   - 成功・エラーメッセージの明示的表示
   - Bootstrap 5による現代的なレスポンシブデザイン
*@
